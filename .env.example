# Your domain. Point an A/AAAA record at the VM. If you use Cloudflare DNS, keep the
# record "DNS only" (grey cloud): proxying would terminate TLS at Cloudflare.
DOMAIN=files.example.com

# Required to upload. Generate one with:  openssl rand -base64 32
UPLOAD_SECRET=

# Largest file accepted, in MB.
MAX_FILE_MB=2048

# Longest lifetime a temporary file may have, in days.
MAX_TEMP_DAYS=365

# Longest lifetime of an AI link, in hours.
MAX_AI_LINK_HOURS=24

# After a burn-after-N-views file's last view, how long (seconds) the viewer can keep downloading.
VIEW_SESSION_SECONDS=3600
